# Copy to .env and fill in. Never commit .env. Keep this file free of real values.

# ngrok agent token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional: reserved ngrok domain, bare hostname only (no https://). Not wired into compose yet (task P5-04).
NGROK_DOMAIN=

# Optional: GitHub token, raises API rate limits for `npm run fetch:github`. Read-only public scope is enough.
GITHUB_TOKEN=

GITHUB_PERSONAL_ACCESS_TOKEN=
